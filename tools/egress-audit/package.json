{
  "name": "ever-egress-audit",
  "version": "0.1.0",
  "description": "The egress audit of a product that hosts the Ever Platform modules: sealed compose networks, CoreDNS as the only resolver, a sniffer per product process and for the browser that walks the product UI, the never-allowed host list, the mock platform's call record, and a self-test with failing controls.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ever-egress-audit": "./run.mjs"
  },
  "exports": {
    "./assert": "./assert.mjs",
    "./assert-call-log": "./assert-call-log.mjs",
    "./static-hostnames": "./static-hostnames.mjs",
    "./cloud-inference": "./cloud-inference.mjs",
    "./overlay": "./lib/overlay.mjs",
    "./runner": "./lib/runner.mjs",
    "./hosts": "./hosts.mjs",
    "./browser": "./browser.mjs",
    "./har": "./lib/har.mjs",
    "./ui-routes": "./routes/cli.mjs",
    "./check-baseline-shrink": "./check-baseline-shrink.mjs"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "selftest": "node run.mjs --selftest"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "playwright-core": "1.62.1",
    "yaml": "2.9.1"
  }
}
