{
  "product": "selftest",
  "compose": ["docker-compose.yml"],
  "api_service": "app",
  "process_services": ["app"],
  "build": true,
  "health_url": "http://app:8080/healthz",
  "health_timeout_s": 90,
  "module_routes": ["/api/ever-connect/status", "/api/ever-stats/status"],
  "adapter": "adapter.mjs",
  "wait_s": 8,
  "web_service": "app",
  "web_url": "http://app:8080",
  "ui_routes": "ui-routes.json",
  "route_params": "route-params.json",
  "idle_pages": ["/settings"],
  "idle_s": 3,
  "ui_page_timeout_s": 30,
  "ui_expected_requests": { "positive_stats": ["GET /api/ever-stats/status"] }
}
