# The mock platform image: node:http and ajv, the contract files in contracts/ (generated by
# tools/generate.mjs), no other code. Build with `docker build tools/mock-platform`.
FROM node:24-alpine AS deps
WORKDIR /mock
RUN printf '{"name":"ever-mock-platform-image","private":true,"type":"module","dependencies":{"ajv":"8.20.0","ajv-formats":"3.0.1"}}\n' > package.json \
  && npm install --omit=dev --no-audit --no-fund --ignore-scripts

FROM node:24-alpine
LABEL org.opencontainers.image.title="ever-mock-platform" \
      org.opencontainers.image.description="Mock of the Ever Platform API for product CI" \
      org.opencontainers.image.source="https://github.com/ever-co/ever-connect-sdk"
WORKDIR /mock
COPY --from=deps /mock/node_modules ./node_modules
COPY package.json ./package.json
COPY bin ./bin
COPY src ./src
COPY contracts ./contracts
ENV PORT=8080 HOST=0.0.0.0 NODE_ENV=production
USER node
EXPOSE 8080
HEALTHCHECK --interval=5s --timeout=3s --retries=10 CMD wget -qO- http://127.0.0.1:8080/__mock/healthz >/dev/null || exit 1
ENTRYPOINT ["node", "bin/ever-mock-platform.mjs"]
