{
  "description": "Rules of tools/check-public-safe.mjs. This file is excluded from the scan because it names the words it bans; the terms it must not spell out are listed under `hashed` as salted sha256 hashes. A finding prints the file, the line and the rule id, never the matched text.",
  "noun": {
    "id": "N1",
    "pattern": "\\bnetworks?\\b",
    "flags": "i",
    "allowed_paths": [
      "tools/egress-audit/",
      "tools/check-public-safe.mjs"
    ],
    "allowed_sections": [
      {
        "file": "docs/outbound-calls.md",
        "heading": "How to verify yourself"
      },
      {
        "file": "docs/stats-schema.md",
        "heading": "Verify it yourself"
      }
    ],
    "technical": [
      "docker network",
      "network_mode",
      "network error",
      "networking",
      "network capture",
      "internal network",
      "network create",
      "--network",
      "^\\s*networks:",
      "\\bnetworks:\\s*\\[",
      "network namespace",
      "NET_RAW",
      "NET_ADMIN",
      "bad-network-noun.md",
      "ok-docker-network.md",
      "sealed (audit |default )?networks?",
      "audit network",
      "compose networks?",
      "product networks?",
      "docker networks?",
      "network (aliases|subnets?)",
      "\\.networks?\\b",
      "\\bnetworks\\s*(=|\\.|\\[|:|,|\\}|\\))",
      "'network'"
    ]
  },
  "banned": [
    {
      "id": "W3",
      "pattern": "\\bA?GPL\\b",
      "flags": "i"
    },
    {
      "id": "W4",
      "pattern": "licen[cs]e[- ]change|\\bre-?licen[cs]|dual[- ]licen|commercial licen|source[- ]available|open[- ]core|\\bBSL\\b|\\bSSPL\\b|Business Source",
      "flags": "i"
    },
    {
      "id": "W5",
      "pattern": "\\bApache\\b",
      "flags": "",
      "allow_lines": [
        "^\\s*\"license\"\\s*:\\s*\"Apache-2\\.0\",?\\s*$",
        "^\\s*license\\s*=\\s*\"Apache-2\\.0\"\\s*$",
        "^\\s*\"Apache-2\\.0( WITH LLVM-exception)?\",?\\s*$"
      ],
      "allow_files": [
        "LICENSE",
        "NOTICE"
      ]
    },
    {
      "id": "W7",
      "description": "the word design before an upper-case document name",
      "pattern": "design [A-Z_]{4,}",
      "flags": ""
    },
    {
      "id": "W9",
      "description": "an HTML comment that opens with an upper-case marker word (a classification or editorial marker)",
      "pattern": "<!--\\s*[A-Z]{5,}(?![a-z])",
      "flags": ""
    }
  ],
