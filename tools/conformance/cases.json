{
  "description": "Non-destructive conformance cases: each one is sent to a running Ever Platform API (the target) and, with --against-mock, to the mock platform, and the status, the problem code and the required response fields are compared. Nothing here connects an installation or changes an organization; the statistics cases report under a fresh statistics id per run, signed with a key derived from a public seed, and every statistics fixture is a case of its own (see run.mjs). `target_only` cases are not asked of the mock. `module` groups the cases by the platform module that serves them; `expect_issuance_off` is the answer of a deployment that issues no connect codes.",
  "cases": [
    {
      "id": "key-manifest",
      "row": 1,
      "module": "connect",
      "request": { "method": "GET", "path": "/.well-known/ever-keys.json" },
      "expect": { "status": 200, "required": ["manifest", "keys"] }
    },
    {
      "id": "legal",
      "row": 2,
      "module": "connect",
      "request": { "method": "GET", "path": "/v1/connect/legal" },
      "expect": { "status": 200 }
    },
    {
      "id": "redeem-unknown-code",
      "row": 3,
      "module": "connect",
      "request": {
        "method": "POST",
        "path": "/v1/connect/redeem",
        "idempotent": true,
        "body": {
          "code": "EVC-AAAA-BBBB-CCCC",
          "product": "gauzy",
          "version": "1.0.0",
          "install_source": "self-hosted",
          "public_jwk": { "kty": "OKP", "crv": "Ed25519", "x": "$conformance_key_x" }
        }
      },
      "expect": { "status": 422, "code": "code_invalid" },
      "expect_issuance_off": { "status": 404, "code": "not_found" }
    },
    {
      "id": "redeem-bad-version",
      "row": 3,
      "module": "connect",
      "request": {
        "method": "POST",
        "path": "/v1/connect/redeem",
        "idempotent": true,
        "body": {
          "code": "EVC-AAAA-BBBB-CCCC",
          "product": "gauzy",
          "version": "v1",
          "install_source": "self-hosted",
          "public_jwk": { "kty": "OKP", "crv": "Ed25519", "x": "$conformance_key_x" }
        }
      },
      "expect": { "status": 422, "code": "validation_failed" },
      "expect_issuance_off": { "status": 404, "code": "not_found" }
    },
    {
      "id": "redeem-malformed",
      "row": 3,
      "module": "connect",
      "request": {
        "method": "POST",
        "path": "/v1/connect/redeem",
        "idempotent": true,
        "body": { "code": "EVC-AAAA-BBBB-CCCC", "version": "1.0.0", "install_source": "self-hosted" }
      },
      "expect": { "status": 422, "code": "validation_failed" }
    },
    {
      "id": "token-malformed-assertion",
      "row": 4,
      "module": "connect",
      "request": {
        "method": "POST",
        "path": "/v1/instances/token",
        "body": {
          "grant_type": "client_credentials",
          "client_assertion_type": "urn:ietf:params:oauth:client-assertion-type:jwt-bearer",
          "client_assertion": "not.a.jws"
        }
      },
      "expect": { "status": 401, "code": "invalid_client" }
    },
    {
      "id": "token-unknown-instance",
      "row": 4,
      "module": "connect",
      "request": {
        "method": "POST",
        "path": "/v1/instances/token",
        "body": {
          "grant_type": "client_credentials",
          "client_assertion_type": "urn:ietf:params:oauth:client-assertion-type:jwt-bearer",
          "client_assertion": "$unknown_instance_assertion"
        }
      },
      "expect": { "status": 401, "code": "invalid_client" }
    },
    {
      "id": "token-wrong-grant",
      "row": 4,
      "module": "connect",
      "request": {
        "method": "POST",
        "path": "/v1/instances/token",
        "body": {
          "grant_type": "password",
          "client_assertion_type": "urn:ietf:params:oauth:client-assertion-type:jwt-bearer",
          "client_assertion": "not.a.jws"
        }
      },
      "expect": { "status": 422, "code": "validation_failed" }
    },
    {
      "id": "rotate-without-token",
      "row": 16,
      "module": "connect",
      "request": {
        "method": "POST",
        "path": "/v1/instances/me/keys",
        "idempotent": true,
        "body": {
          "public_jwk": { "kty": "OKP", "crv": "Ed25519", "x": "$conformance_key_x" },
          "current_key_proof": "not.a.jws",
          "new_key_proof": "not.a.jws"
        }
      },
      "expect": { "status": 401, "code": "unauthorized" }
    },
    {
      "id": "rotate-unknown-token",
      "row": 16,
      "module": "connect",
      "request": {
        "method": "POST",
        "path": "/v1/instances/me/keys",
        "idempotent": true,
        "bearer": "$unknown_instance_token",
        "body": {
          "public_jwk": { "kty": "OKP", "crv": "Ed25519", "x": "$conformance_key_x" },
          "current_key_proof": "not.a.jws",
          "new_key_proof": "not.a.jws"
        }
      },
      "expect": { "status": 401, "code": "unauthorized" }
    },
    {
      "id": "stats-accepted",
      "row": 17,
      "module": "stats",
      "stats": { "fixture": "stats/valid/gauzy.json" },
      "expect": { "status": 202, "required": ["accepted"] }
    },
    {
      "id": "stats-bad-signature",
      "row": 17,
      "module": "stats",
      "stats": { "fixture": "stats/valid/gauzy.json", "mutate": "signature" },
      "expect": { "status": 400, "code": "signature_invalid", "path": "#Ever-Stats-Signature", "error": "invalid" }
    },
    {
      "id": "stats-missing-key",
      "row": 17,
      "module": "stats",
      "stats": { "fixture": "stats/valid/gauzy.json", "mutate": "no-key" },
      "expect": { "status": 400, "code": "validation_failed", "path": "#Ever-Stats-Key", "error": "invalid" }
    },
    {
      "id": "stats-key-not-a-point",
      "row": 17,
      "module": "stats",
      "stats": { "fixture": "stats/valid/gauzy.json", "mutate": "not-a-point" },
      "expect": { "status": 400, "code": "validation_failed", "path": "#Ever-Stats-Key", "error": "invalid" }
    },
    {
      "id": "stats-missing-signature",
      "row": 17,
      "module": "stats",
      "stats": { "fixture": "stats/valid/gauzy.json", "mutate": "no-signature" },
      "expect": { "status": 400, "code": "signature_invalid", "path": "#Ever-Stats-Signature", "error": "invalid" }
    },
    {
      "id": "stats-key-id-mismatch",
      "row": 17,
      "module": "stats",
      "stats": { "fixture": "stats/valid/gauzy.json", "mutate": "key-id" },
      "expect": { "status": 400, "code": "signature_invalid", "path": "#Ever-Stats-Key-Id", "error": "invalid" }
    },
    {
      "id": "stats-media-type",
      "row": 17,
      "module": "stats",
      "stats": { "fixture": "stats/valid/gauzy.json", "mutate": "media-type" },
      "expect": { "status": 415, "code": "unsupported_media_type" }
    },
    {
      "id": "stats-schema-violation",
      "row": 17,
      "module": "stats",
      "stats": { "fixture": "stats/invalid/01-extra-field.json" },
      "expect": { "status": 422, "code": "schema_violation", "path": "/tenant_name", "error": "unknown_field" }
    },
    {
      "id": "stats-key-mismatch",
      "row": 17,
      "module": "stats",
      "stats": { "fixture": "stats/valid/gauzy.json", "mutate": "other-key" },
      "expect": { "status": 409, "code": "key_mismatch" }
    },
    {
      "id": "stats-schema",
      "row": null,
      "module": "stats",
      "target_only": true,
      "request": { "method": "GET", "path": "/v1/stats/schema" },
      "expect": { "status": 200, "sha256_of": "schemas/ever.stats.v1.json", "etag": true }
    }
  ]
}
