{
  "name": "@ever-co/connect-sdk",
  "version": "1.0.0-rc.4",
  "description": "Ever Platform connection SDK: the client over the generated operation table, the key manifest and entitlement verifier, the client assertion, lookup hashing, usage readings, the anonymous statistics signer and the managed-operation runner.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ever-co/ever-connect-sdk.git",
    "directory": "packages/ts/connect-sdk"
  },
  "homepage": "https://github.com/ever-co/ever-connect-sdk/tree/main/packages/ts/connect-sdk#readme",
  "bugs": {
    "url": "https://github.com/ever-co/ever-connect-sdk/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ever-co/connect-contracts": "workspace:*",
    "ajv": "8.20.0"
  }
}
