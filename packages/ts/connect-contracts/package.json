{
  "name": "@ever-co/connect-contracts",
  "version": "1.0.0-rc.6",
  "description": "Ever Platform connection contracts: request and response types, JSON Schemas, integration definitions, wire constants and fixtures. No runtime dependencies.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ever-co/ever-connect-sdk.git",
    "directory": "packages/ts/connect-contracts"
  },
  "homepage": "https://github.com/ever-co/ever-connect-sdk/tree/main/packages/ts/connect-contracts#readme",
  "bugs": {
    "url": "https://github.com/ever-co/ever-connect-sdk/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./fixtures/*": "./fixtures/*",
    "./schemas/*": "./schemas/*",
    "./integrations/*": "./integrations/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fixtures",
    "schemas",
    "integrations"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "scripts": {
    "build": "node scripts/copy-contracts.mjs && tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  }
}
