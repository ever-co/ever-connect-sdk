{
  "description": "The scope of contract v1 for installations of Ever products: which operations of the Ever Platform API an installation calls (the instance-facing set an SDK pins), which of them contract v1 serves (pinned in ever-api.v1.json) and which it does not serve yet (not_in_v1: designed, never answered by a v1 deployment; a later minor version of the contract adds them without changing anything pinned). An SDK release for contract v1 carries only pinned operations; a not_in_v1 operation is neither generated nor documented as callable, and its outbound-call row says it is not available yet. Checked by tools/check-contract-scope.mjs against the pinned contract and the design; `pinned` is written by its --write.",
  "contract": "contracts/openapi/ever-api.v1.json",
  "version": "1.0.0",
  "selection": {
    "description": "An operation is instance-facing when it accepts instanceToken, or it is one of `also` (the public calls an installation makes and the two reads it makes with a signed-in person's token). Paths under never_path_prefixes and operations that accept never_security are never instance-facing; `exclude` names the ones left out on purpose.",
    "select_security": [
      "instanceToken"
    ],
    "also": [
      "get_key_manifest",
      "getConnectLegal",
      "connectRedeem",
      "instanceToken",
      "connectDevice",
      "connectDeviceToken",
      "ingestStatsReport",
      "getLookupSalt",
      "getLookupTestVectors",
      "discoverSso",
      "getMyContext",
      "listMyMemberships"
    ],
    "never_path_prefixes": [
      "/internal",
      "/v1/staff"
    ],
    "never_security": [
      "staffSession"
    ],
    "exclude": {
      "subscribeRealtime": "the server-sent event stream serves the app.ever.co browser; installations read the instance feed"
    },
    "design_aliases": {
      "getKeyManifest": "get_key_manifest"
    }
  },
