  "security": {
    "putIntegrationState": {
      "row": 33,
      "instance_facing": false,
      "accepted": [
        "personSession",
        "everIdToken"
      ],
      "not_in_v1": [
        "everIdStepUpToken"
      ],
      "why": "Contract v1 accepts a person's app.ever.co session or an Ever ID token of the Ever Platform project from a sign-in at most 300 s old; a token a product, an installation or an App obtained is refused with 403 session_required. Consenting from a product's own dialog with a product step-up token is not part of v1, so no installation calls this operation in v1: a product sends its admin to app.ever.co with the signed link of instanceGetConsentUrl. The operation's limits (Idempotency-Key, the person rate class, a 16 KiB body, the closed body, current scope and agreement versions) are stated in the pinned contract."
    }
  },
